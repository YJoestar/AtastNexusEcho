# NEXUS — Environment Variables Template
# Copy to .env.local and fill in your values.
#
# CLIENT-SAFE variables (prefixed with VITE_) are embedded in the browser bundle.
# Never put secrets here — only the anonymous key (which is intentionally public
# and protected by Row Level Security policies).
#
# SUPABASE_URL — your Supabase project URL
# SUPABASE_ANON_KEY — your Supabase anonymous (public) key
#
# BUREAU credentials in .env.bureau (NOT committed to git):
#   BUREAU_EMAIL, BUREAU_PASSWORD — for Bureau admin dashboard login

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE

# Application Configuration
VITE_APP_NAME=NEXUS
VITE_APP_VERSION=0.1.0
VITE_APP_ENV=production

# Feature Flags
VITE_ENABLE_DEV_TOOLS=false
